# ---------------------------------------------------------------- Daten
# Hochgeladene Familiendateien gehören NIE ins Git-Repository.
/data/
# Früherer Frontend-Ordner: nach dem Update nur noch Build-Reste und ggf.
# Uploads aus Version 1 (start.sh räumt ihn auf)
/familienserver/

# Protokolle – landen alle im Ordner logs/
/logs/
*.log

# Zugangsdaten und lokale Einstellungen
.env
.env.*
!.env.example

# ------------------------------------------------------------- Frontend
node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
.vercel

# --------------------------------------------------------------- Python
# Bewusst nur im Wurzelverzeichnis – ein allgemeines „lib/“ hätte auch
# frontend/app/lib/ ignoriert.
__pycache__/
*.py[cod]
/build/
/dist/
/lib/
/lib64/
*.egg-info/
.pytest_cache/
/venv/
/.venv/
/env/

# ------------------------------------------------------------ Sonstiges
*.tmp
.DS_Store
.idea/
.vscode/
*.swp
*.pem
