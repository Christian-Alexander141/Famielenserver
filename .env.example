# Familienserver – Einstellungen
# Kopieren nach .env und anpassen:  cp .env.example .env
# (./start.sh legt die Datei beim ersten Start automatisch an und fragt nach dem Passwort.)

# Pflicht: gemeinsames Passwort für alle Familienmitglieder (mindestens 8 Zeichen)
FAMILIENSERVER_PASSWORD=

# Wo die Dateien liegen. Standard: Ordner „data“ im Projektverzeichnis.
# Beispiel externe Festplatte:
# FAMILIENSERVER_DATA_DIR=/media/familie/usb/familienserver

# Wie viele Tage gelöschte Dateien im Papierkorb bleiben (0 = bis zum manuellen Leeren)
# FAMILIENSERVER_TRASH_DAYS=30

# Maximale Größe einer einzelnen Datei in MB
# FAMILIENSERVER_MAX_UPLOAD_MB=4096

# Nur hinter einem Reverse Proxy mit HTTPS (z. B. nginx, Caddy):
# FAMILIENSERVER_SECURE_COOKIES=1
# FAMILIENSERVER_TRUST_PROXY=1
